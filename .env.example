# Tengu Cluster environment variables
#
# Note:
# - The binary does not auto-load `.env`.
# - Export these in your shell, `direnv`, or your process manager.

# -----------------------------------------------------------------------------
# Runtime pathing
# -----------------------------------------------------------------------------

# Base state/config directory. Used by runtime fallback path resolution.
# Code path: src/main.rs (`resolve_tengu_home`)
TENGU_HOME=~/.tengu

# -----------------------------------------------------------------------------
# Model backend runtime (implemented now)
# -----------------------------------------------------------------------------

# Ollama base URL for model requests and doctor checks.
# Code path: src/main.rs, src/main.rs (`run_doctor`)
OLLAMA_HOST=http://localhost:11434

# Anthropic API key for hosted Anthropic backend.
# Code path: src/main.rs (`build_engine`), crates/tengu-backends/src/anthropic/mod.rs
ANTHROPIC_API_KEY=

# Optional Anthropic API endpoint override (default: https://api.anthropic.com).
# Useful for proxies or enterprise gateways.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI API key for hosted OpenAI backend.
# Code path: src/main.rs (`build_engine`), crates/tengu-backends/src/openai/mod.rs
OPENAI_API_KEY=

# Optional OpenAI API endpoint override (default: https://api.openai.com).
# Useful for proxies or enterprise gateways.
OPENAI_BASE_URL=https://api.openai.com

# Optional Claude Code CLI binary path.
# Used when `engine = "claude-code"` (default: `claude` from PATH).
# Code path: src/main.rs (`build_engine`), crates/tengu-backends/src/claude_code/mod.rs
# CLAUDE_CODE_BIN=claude

# Optional runtime log level filter used by tracing subscriber.
# Example values: info, debug, tengu=debug
RUST_LOG=info

# Optional delegated assignment TTL (seconds).
# Runtime auto-expires delegated `/assign` entries older than this value.
# Code path: src/main.rs (`prune_expired_capability_assignments`)
# TENGU_DELEGATED_ASSIGNMENT_TTL_SECS=900

# Optional max rows retained in delegated assignment audit log.
# Runtime prunes `state/audit/capability_assignments.jsonl` to this tail size at startup.
# Code path: src/main.rs, src/control_plane_audit.rs
# TENGU_CONTROL_PLANE_AUDIT_MAX_ROWS=20000

# Optional row count scanned from delegated assignment audit log at startup replay.
# Effective value is clamped to `TENGU_CONTROL_PLANE_AUDIT_MAX_ROWS`.
# Code path: src/main.rs (`load_persisted_capability_assignments`)
# TENGU_CONTROL_PLANE_AUDIT_REPLAY_LIMIT=512

# Optional NVIDIA CUDA visibility hint used in runtime profile detection heuristics.
# Code path: crates/tengu-core/src/config/profile.rs
# On Apple Silicon, Metal is auto-detected (no CUDA var required).
# CUDA_VISIBLE_DEVICES=0

# Optional cross-platform override for coarse GPU detection.
# Values: auto (default), cpu|none|off, gpu|cuda|metal|mps.
# Useful for forcing profile behavior on Mac Mini / CI / containers.
# TENGU_GPU_HINT=metal

# -----------------------------------------------------------------------------
# Hub/channel config substitution (used if referenced in config.toml)
# -----------------------------------------------------------------------------

# Hub auth token if `auth_token = "${TENGU_TOKEN}"` is set in config.
TENGU_TOKEN=change-me

# Telegram bot token if Telegram pipe is enabled in config.
TELEGRAM_BOT_TOKEN=

# Discord bot token if Discord pipe is enabled in config.
DISCORD_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Planned provider integrations (future backends)
# -----------------------------------------------------------------------------

# Google API key (planned backend).
GOOGLE_API_KEY=

# Hugging Face token with Inference Providers permission (planned backend).
HF_TOKEN=

# Optional Hugging Face Inference Providers base URL override.
# Default target for planned backend: https://router.huggingface.co/v1
# Use this only when routing through a dedicated provider endpoint or proxy.
# HF_BASE_URL=https://router.huggingface.co/v1
