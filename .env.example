# Tengu Cluster — Debug .env (all values here, no vault)
#
# Loaded at startup via dotenvy. Values here are NOT redacted in agent output.
# To re-enable redaction for secrets, move API keys back to the vault later.

# --- Runtime ---
# TENGU_HOME=~/.tengu
# RUST_LOG=info

# # --- OpenRouter (primary engine) ---
# OPENROUTER_API_KEY=

# # --- Anthropic ---
# ANTHROPIC_API_KEY=

# # --- Telegram ---
# # Fill in your bot token:
# TELEGRAM_BOT_TOKEN=

# # --- Privy Agentic Wallets ---
# # Copy these from your vault: cargo run -- secret list
# # Then fill in the values below:
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_WALLET_ID=
# PRIVY_WALLET_ADDRESS=

# # --- Molecule DeSci Labs ---
# MOLECULE_API_KEY=da2-zioxgd77l5ec5n645xqlbmmp4q
# MOLECULE_LABS_URL=https://production.graphql.api.molecule.xyz/graphql
# MOLECULE_CLIENT_URL=https://molecule.xyz
# IPNFT_CONTRACT_ADDRESS=0xcaD88677CA87a7815728C72D74B4ff4982d54Fc1

# # --- POI (Proof of Invention) ---
