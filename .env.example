# Tengu Cluster — .env template
#
# Every value below is an EMPTY PLACEHOLDER. Real secrets belong in the
# encrypted vault (`tengu secret set KEY VALUE`) or in a gitignored `.env`
# copied from this file. Loaded at startup via dotenvy; values here are NOT
# redacted in agent output.

# --- Runtime ---
# TENGU_HOME=~/.tengu                      # state root (config, vault, logs, memory)
# TENGU_CONFIG=                            # path to config.toml (overrides ~/.tengu/config.toml)
# TENGU_MASTER_PASSWORD=                   # skips the vault password prompt
# TENGU_SESSION_ID=                        # pin the orchestrator session id (default: fresh UUID)
# TENGU_TOR_PROXY=socks5h://127.0.0.1:9050 # Tor proxy override ([egress] network = "tor" default)
# TELOXIDE_PROXY is set by tengu itself from the egress policy — do not set it here
# RUST_LOG=tengu=info                      # tracing filter; one `metrics` line per LLM call at info

# --- OpenRouter (primary engine) ---
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=                     # default https://openrouter.ai/api
# OPENROUTER_REFERER=                      # optional HTTP-Referer header
# OPENROUTER_TITLE=                        # optional X-Title header

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=                      # from @BotFather
# TENGU_TELEGRAM_ALLOWED_USERS=            # comma-separated user ids; merged with [telegram].allowed_users

# --- Agentic memory (Postgres + pgvector, `postgres_memory` feature) ---
# TENGU_MEMORY_DATABASE_URL=postgres://tengu:tengu@localhost:5432/tengu_memory
# TENGU_WIKI_COMPILER_MODEL=               # compile_wiki model (OpenRouter slug); default anthropic/claude-sonnet-4-6

# --- Webhooks (`tengu webhooks`, `webhooks` feature) ---
# TENGU_TEST_WEBHOOK_SECRET=               # HMAC secret for sandboxes/aura [webhooks.endpoints.test]

# --- TUI debug panels (opt-in) ---
# TENGU_TUI_METRICS=1                      # token/latency status line after every LLM call
# TENGU_TUI_RAG_DEBUG=1                    # planner recall hits as a System bubble

# --- Privy Agentic Wallets ---
# Copy these from your vault: cargo run -- secret list
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_WALLET_ID=
# PRIVY_WALLET_ADDRESS=

# --- Molecule DeSci Labs ---
# MOLECULE_API_KEY=
# MOLECULE_LABS_URL=https://production.graphql.api.molecule.xyz/graphql
# MOLECULE_CLIENT_URL=https://molecule.xyz
# IPNFT_CONTRACT_ADDRESS=0xcaD88677CA87a7815728C72D74B4ff4982d54Fc1   # public contract address

# --- POI (Proof of Invention) ---
# POI_API_KEY=

# --- Beach.Science ---
# BEACH_SCIENCE_API_KEY=
# BEACH_API_KEY=

# --- EVM (RPC only — signing uses Privy agentic wallet) ---
# CHAIN_ID=                                # default chain id when a tool call omits it
# EVM_RPC_URL=                             # default https://ethereum-rpc.publicnode.com
# ALCHEMY_API_KEY=
# EVM_WALLET_ADDRESS=
# X402_GATEWAY_URL=
