# Tengu Cluster environment variables
#
# Note:
# - The binary does not auto-load `.env`.
# - Export these in your shell, `direnv`, or your process manager.

# -----------------------------------------------------------------------------
# Runtime pathing
# -----------------------------------------------------------------------------

# Base state/config directory. Used by runtime fallback path resolution.
# Code path: src/main.rs (`resolve_tengu_home`)
TENGU_HOME=~/.tengu

# -----------------------------------------------------------------------------
# Model backend runtime (implemented now)
# -----------------------------------------------------------------------------

# Ollama base URL for model requests and doctor checks.
# Code path: src/main.rs, src/main.rs (`run_doctor`)
OLLAMA_HOST=http://localhost:11434

# Anthropic API key for hosted Anthropic backend.
# Code path: src/main.rs (`build_engine`), crates/tengu-backends/src/anthropic/mod.rs
ANTHROPIC_API_KEY=

# Optional Anthropic API endpoint override (default: https://api.anthropic.com).
# Useful for proxies or enterprise gateways.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional runtime log level filter used by tracing subscriber.
# Example values: info, debug, tengu=debug
RUST_LOG=info

# Optional NVIDIA CUDA visibility hint used in runtime profile detection heuristics.
# Code path: crates/tengu-core/src/config/profile.rs
# On Apple Silicon, Metal is auto-detected (no CUDA var required).
# CUDA_VISIBLE_DEVICES=0

# Optional cross-platform override for coarse GPU detection.
# Values: auto (default), cpu|none|off, gpu|cuda|metal|mps.
# Useful for forcing profile behavior on Mac Mini / CI / containers.
# TENGU_GPU_HINT=metal

# -----------------------------------------------------------------------------
# Hub/channel config substitution (used if referenced in config.toml)
# -----------------------------------------------------------------------------

# Hub auth token if `auth_token = "${TENGU_TOKEN}"` is set in config.
TENGU_TOKEN=change-me

# Telegram bot token if Telegram pipe is enabled in config.
TELEGRAM_BOT_TOKEN=

# Discord bot token if Discord pipe is enabled in config.
DISCORD_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Planned provider integrations (future backends)
# -----------------------------------------------------------------------------

# OpenAI API key (planned backend).
OPENAI_API_KEY=

# Google API key (planned backend).
GOOGLE_API_KEY=

# Hugging Face token (planned backend/inference path).
HF_TOKEN=
