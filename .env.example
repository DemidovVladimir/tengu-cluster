# Tengu Cluster environment variables
#
# The binary auto-loads this file at startup via dotenvy.

# Base state/config directory.
TENGU_HOME=~/.tengu

# OpenRouter API key (required for OpenRouter engine and memory embeddings)
# One API key for all providers — browse models at https://openrouter.ai/models
OPENROUTER_API_KEY=
# Optional endpoint override
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# Optional attribution for OpenRouter leaderboard
# OPENROUTER_REFERER=https://your-site.com
# OPENROUTER_TITLE=Tengu Cluster

# Claude Code CLI (when using claude_code engine)
# Requires: cargo build --features claude_code
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_PERMISSION_MODE=dontAsk
# CLAUDE_CODE_DANGEROUSLY_SKIP_PERMISSIONS=false

# Telegram bot token (when using telegram channel)
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs (merged with config allowed_users)
# TENGU_TELEGRAM_ALLOWED_USERS=123456789,987654321

# Privy agentic wallets (used by privy and aura-orchestrator skills)
# PRIVY_APP_ID=clz...
# PRIVY_APP_SECRET=
# PRIVY_WALLET_ID=

# Qdrant vector store (requires: cargo build --features qdrant)
# QDRANT_API_KEY=

# Secrets vault master password (skips interactive prompt)
# TENGU_MASTER_PASSWORD=

# Beach.science API key (used by beach-science skill as $BEACH_API_KEY)
# BEACH_API_KEY=beach_...

# Molecule DeSci Labs (used by aura-orchestrator skill)
# MOLECULE_API_KEY=
# MOLECULE_LABS_URL=https://staging.graphql.api.molecule.xyz/graphql
# MOLECULE_CLIENT_URL=https://testnet.molecule.xyz

# POI (Proof of Invention) registration API
# POI_API_KEY=

# API relay (planned) — Cloudflare Worker proxy that injects API keys server-side.
# TENGU_RELAY_URL=https://tengu-relay.<your-subdomain>.workers.dev
# TENGU_RELAY_TOKEN=

# Logging
RUST_LOG=info
