# Tengu Cluster environment variables
#
# The binary auto-loads this file at startup via dotenvy.

# Base state/config directory.
TENGU_HOME=~/.tengu

# Ollama base URL (when using ollama engine)
OLLAMA_HOST=http://localhost:11434

# Anthropic API key (when using anthropic engine)
ANTHROPIC_API_KEY=
# Optional endpoint override
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI API key (when using openai engine)
OPENAI_API_KEY=
# Optional endpoint override
# OPENAI_BASE_URL=https://api.openai.com

# Hugging Face token (when using huggingface engine)
HF_TOKEN=
# Optional endpoint override
# HF_BASE_URL=https://router.huggingface.co/v1

# Claude Code CLI binary (when using claude-code engine)
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_PERMISSION_MODE=dontAsk
# CLAUDE_CODE_DANGEROUSLY_SKIP_PERMISSIONS=false

# OpenRouter API key (when using openrouter engine — aggregates all providers)
OPENROUTER_API_KEY=
# Optional endpoint override
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# Optional attribution for OpenRouter leaderboard
# OPENROUTER_REFERER=https://your-site.com
# OPENROUTER_TITLE=Tengu Cluster

# Telegram bot token (when using telegram channel)
TELEGRAM_BOT_TOKEN=

# Skill API keys (auto-derived from skill name: <SKILL_NAME>_API_KEY)
# BEACH_SCIENCE_API_KEY=beach_...

# Logging
RUST_LOG=info
