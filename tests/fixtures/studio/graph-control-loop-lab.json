  "nodes": [
    {
      "id": "runtime:control-loop-lab",
      "kind": "runtime",
      "label": "tengu run",
      "layer": 0,
      "order": 0,
      "attrs": {
        "heartbeat_secs": 2,
        "heartbeat_stale_secs": 10,
        "max_decisions_in_flight": 1,
        "max_queued_per_loop": 4,
        "shutdown_grace_secs": 10
      },
      "narrowed_out": false
    },
    {
      "id": "trigger:decide",
      "kind": "trigger",
      "label": "tengu decide",
      "layer": 1,
      "order": 0,
      "attrs": {
        "command": "tengu decide --loop <name> | --map <file>"
      },
      "narrowed_out": false
    },
    {
      "id": "feed:probe",
      "kind": "feed",
      "label": "probe",
      "layer": 1,
      "order": 1,
      "attrs": {
        "agent": "lab",
        "args": {
          "path": "in/absent.txt"
        },
        "every_secs": 30,
        "jitter_pct": 0,
        "kind": "tool",
        "required": false,
        "run_on_start": true,
        "tool": "read_file"
      },
      "narrowed_out": false
    },
    {
      "id": "feed:tick",
      "kind": "feed",
      "label": "tick",
      "layer": 1,
      "order": 2,
      "attrs": {
        "event": {
          "scenario": "normal",
          "source": "tick"
        },
        "every_secs": 20,
        "jitter_pct": 0,
        "kind": "tick",
        "required": true,
        "run_on_start": true,
        "stale_after_secs": 60,
        "target": "demo"
      },
      "narrowed_out": false
    },
    {
      "id": "loop:demo",
      "kind": "loop",
      "label": "demo",
      "layer": 2,
      "order": 0,
      "attrs": {
        "act_at": 0.8,
        "agent": "lab",
        "dry_run": false,
        "escalate": false,
        "goal": "Control-loop lab. Act on event.scenario:\n- \"normal\": nothing to do — pick hold.\n- \"act\": run write_marker once, then pick hold.\n- \"tool-error\": run read_probe once (expected to fail; never retry it), then pick hold.\n- \"uncertain\": the evidence is contradictory and no action is clearly right.\nNever run an action twice for one event. Any other scenario: hold.",
        "history": 4,
        "max_steps": 3,
        "model": "~typesafe/jev-latest",
        "timeout_secs": 20,
        "world_max_age_secs": 60
      },
      "narrowed_out": false
    },
    {
      "id": "agent:lab",
      "kind": "agent",
      "label": "lab",
      "layer": 2,
      "order": 1,
      "attrs": {
        "engine": "openrouter",
        "model": "anthropic/claude-haiku-4-5",
        "workspace": "~/tengu-lab/control-loop-lab"
      },
      "narrowed_out": false
    },
    {
      "id": "world:demo/tick",
      "kind": "world",
      "label": "tick",
      "layer": 3,
      "order": 0,
      "attrs": {
        "key": "feed/1:tick",
        "max_age_secs": 60
      },
      "narrowed_out": false
    },
    {
      "id": "jev:demo",
      "kind": "jev",
      "label": "~typesafe/jev-latest",
      "layer": 4,
      "order": 0,
      "attrs": {
        "history": 4,
        "model": "~typesafe/jev-latest",
        "timeout_secs": 20
      },
      "narrowed_out": false
    },
    {
      "id": "gate:demo/act_at",
      "kind": "gate",
      "label": "act_at 0.8",
      "layer": 4,
      "order": 1,
      "attrs": {
        "act_at": 0.8,
        "escalate": false
      },
      "narrowed_out": false
    },
    {
      "id": "action:demo/hold",
      "kind": "action",
      "label": "hold",
      "layer": 5,
      "order": 0,
      "attrs": {
        "description": "Nothing (more) to do for this event — stop",
        "effect": "terminal",
        "read_only": false
      },
      "narrowed_out": false
    },
    {
      "id": "action:demo/read_probe",
      "kind": "action",
      "label": "read_probe",
      "layer": 5,
      "order": 1,
      "attrs": {
        "args": {
          "path": "in/{probe}.txt"
        },
        "description": "Read the probe file in/absent.txt from the lab workspace",
        "effect": "runs",
        "read_only": true,
        "slots": {
          "probe": [
            "absent"
          ]
        },
        "tool": "read_file"
      },
      "narrowed_out": false
    },
    {
      "id": "action:demo/write_marker",
      "kind": "action",
      "label": "write_marker",
      "layer": 5,
      "order": 2,
      "attrs": {
        "args": {
          "content": "scenario={scenario}",
          "path": "out/marker.txt"
        },
        "description": "Write the scenario marker file out/marker.txt in the lab workspace",
        "effect": "runs",
        "read_only": false,
        "slots": {
          "scenario": {
            "event": "/scenario",
            "top": 5
          }
        },
        "tool": "write_file"
      },
      "narrowed_out": false
    },
